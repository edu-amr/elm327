{
  "name": "elm327",
  "version": "2.0.0",
  "description": "ELM327 OBD-II library and live terminal dashboard for Node.js and TypeScript: read RPM, speed, trouble codes and VIN over USB serial, WiFi or Bluetooth, with a built-in vehicle simulator.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "demo": "tsx src/cli/index.ts --demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "elm327",
    "obd2",
    "obd-ii",
    "obdii",
    "obd",
    "can-bus",
    "canbus",
    "iso-15765",
    "j1979",
    "diagnostics",
    "dtc",
    "trouble-codes",
    "vin",
    "pid",
    "ecu",
    "scan-tool",
    "automotive",
    "vehicle",
    "car",
    "telemetry",
    "serialport",
    "wifi",
    "bluetooth",
    "ble",
    "typescript",
    "cli",
    "tui",
    "terminal-dashboard",
    "simulator",
    "tachometer"
  ],
  "author": {
    "name": "Eduardo Amaro",
    "email": "edu.amr@hotmail.com",
    "url": "https://github.com/edu-amr"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edu-amr/elm327.git"
  },
  "bugs": {
    "url": "https://github.com/edu-amr/elm327/issues"
  },
  "homepage": "https://github.com/edu-amr/elm327#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "elm327": "dist/cli/index.js"
  }
}
